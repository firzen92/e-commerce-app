NODE_ENV=development
PORT=3000

# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — server-side only, never expose to the Angular client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings > API > JWT Settings > JWT Secret (used to verify Supabase Auth tokens)
SUPABASE_JWT_SECRET=your-jwt-secret

# Angular dev server origin allowed to call this API
CORS_ORIGIN=http://localhost:4200
