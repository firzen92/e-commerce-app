NODE_ENV=development
PORT=3000

# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key — server-side only, never expose to the Angular client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Auth tokens are verified against the project's published JWKS
# (`${SUPABASE_URL}/auth/v1/.well-known/jwks.json`), so no separate JWT secret is needed here —
# see src/modules/auth/strategies/jwt.strategy.ts.

# Angular dev server origin allowed to call this API
CORS_ORIGIN=http://localhost:4200
